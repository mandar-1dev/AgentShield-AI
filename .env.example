# Copy to .env (never commit .env)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30
AGENTSHIELD_DEMO_MODE=true
AGENTSHIELD_DB_PATH=agentshield.db
# REQUIRED for approve/reject endpoints. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENTSHIELD_ADMIN_TOKEN=
AGENTSHIELD_APPROVAL_TTL_SECONDS=900
AGENTSHIELD_MAX_AGENT_ITERATIONS=5
# Optional policy overrides, e.g. {"get_system_health":"approval_required"}
AGENTSHIELD_POLICY_OVERRIDES={}
AGENTSHIELD_HOST=127.0.0.1
AGENTSHIELD_PORT=8000
